update_fastlane

default_platform(:ios)

platform :ios do

  lane :reset_version_code do
    f = File.new("fastlane/metadata/versionCode", "w")
    f.write("0")
    f.close
  end

  lane :bump_version_code do
    versionCode = File.read("metadata/versionCode").to_i
    versionCode = versionCode + 1
    
    f = File.new("metadata/versionCode", "w")
    f.write(versionCode)
    f.close
    versionCode
  end
  
  desc "Push a new release build to the App Store"
  lane :prod do
    versionCode = bump_version_code

    sh("flutter","build","ipa","--build-name", "1.0.#{versionCode}","--build-number", "#{versionCode}","--dart-define-from-file=assets/config.json")
    upload_to_app_store(ipa: "../build/ios/ipa/sapidlabs.ipa",
    submit_for_review: true,
    automatic_release: true,
    force: true,
    submission_information: {
    "export_compliance_uses_encryption": false,
    "add_id_info_uses_idfa": false},
    ipa: "../build/ios/ipa/sapidlabs.ipa"
    )
    
    send_slack_notification(message: "New production version 1.0.#{versionCode} (#{versionCode}) has been pushed to App Store!")  
  end
  
  desc "Push a new beta build to TestFlight"
  lane :beta do
    versionCode = bump_version_code

    sh("flutter","build","ipa","--build-name", "1.0.#{versionCode}","--build-number", "#{versionCode}","--dart-define-from-file=assets/config.json")
    upload_to_testflight(ipa: "../build/ios/ipa/sapidlabs.ipa")
    
    send_slack_notification(message: "New internal version 1.0.#{versionCode} (#{versionCode}) has been pushed to TestFlight!")
    
  end
  
  desc "Send a message to Slack"
  lane :send_slack_notification do |options|
    message = options[:message] || "A new update has been pushed!"
    # Every app posts to ONE shared webhook, so a message that does not name its
    # app cannot be read in that channel. The name is read from pubspec.yaml, so
    # an app scaffolded from this template labels itself with no rename step.
    # SLACK_APP_LABEL overrides it. (A lane body runs with cwd = fastlane/.)
    app_label = ENV["SLACK_APP_LABEL"].to_s.strip
    if app_label.empty?
      app_label = begin
        File.read("../../pubspec.yaml")[/^name:\s*(\S+)/, 1] || "unknown app"
      rescue StandardError
        "unknown app"
      end
    end
    message = "*#{app_label} (iOS)* — #{message}"
    slack(
    message: message,
    success: true,
    slack_url: ENV["SLACK_WEBHOOK_URL"]
    )
  end
end
