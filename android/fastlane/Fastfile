require "shellwords"
require "tmpdir"

update_fastlane

default_platform(:android)

platform :android do

  lane :reset_version_code do
    f = File.new("fastlane/metadata/versionCode", "w")
    f.write("0")
    f.close
  end

  lane :bump_version_code do
    versionCode = File.read("metadata/versionCode").to_i
    versionCode = versionCode + 1
    
    f = File.new("metadata/versionCode", "w")
    f.write(versionCode)
    f.close
    versionCode
  end
  
  # Verify the built bundle carries the upload certificate we expect, BEFORE it is
  # uploaded. Only runs when EXPECTED_SIGNING_SHA256 is set, so a manual run and a
  # CI run are both unaffected; loop/release.sh in the fun-money repo sets it.
  #
  # Two traps, both learned the hard way on the shipped apps: jarsigner exits
  # non-zero on every Play bundle because of hundreds of benign "signed in JarFile
  # but is not signed in JarInputStream" warnings, so grep for "jar verified."
  # instead of trusting the exit code. And the certificate lives in
  # META-INF/UPLOAD.RSA inside the AAB.
  lane :verify_signing do |options|
    expected = ENV["EXPECTED_SIGNING_SHA256"]
    next UI.message("EXPECTED_SIGNING_SHA256 unset - skipping signature check") if expected.to_s.empty?

    aab = options[:aab]
    UI.user_error!("no bundle at #{aab.inspect}") unless aab && File.exist?(aab)

    verified = `jarsigner -verify #{Shellwords.escape(aab)} 2>&1`
    UI.user_error!("#{aab} is not signed ('jar verified.' absent)") unless verified.include?("jar verified.")

    Dir.mktmpdir do |tmp|
      sh("unzip", "-o", "-q", File.expand_path(aab), "META-INF/UPLOAD.RSA", "-d", tmp)
      printed = `keytool -printcert -file #{Shellwords.escape(File.join(tmp, "META-INF/UPLOAD.RSA"))}`
      actual = printed[/SHA256:\s*([0-9A-F:]+)/i, 1].to_s.strip
      if actual.casecmp(expected.strip) != 0
        UI.user_error!("WRONG SIGNING KEY. expected #{expected} got #{actual} - refusing to upload")
      end
      UI.success("signature verified: #{actual}")
    end
  end

  desc "Deploy a new version to Google Play with specified track"
  # This one lane serves both a person on a laptop and the CI runner
  # (.github/workflows/release-android.yml). Two details make that true, and both
  # were paid for by a real failure elsewhere in the portfolio:
  #
  #   - Paths are absolute, resolved from wherever pubspec.yaml actually is.
  #     fastlane's working directory is not the same for every caller, and relative
  #     paths that work by hand can point somewhere odd under CI.
  #   - The Play key comes from PLAY_JSON_KEY_PATH when it is set, and from the
  #     Appfile when it is not. CI has no ~/Dev/keys, and a laptop has no env var.
  lane :deploy do |options|
    track = options[:track] || 'internal'

    root = [
      ((__dir__ rescue nil) && File.expand_path("../..", __dir__)),
      File.expand_path("..", Dir.pwd),
      Dir.pwd,
    ].compact.find { |candidate| File.exist?(File.join(candidate, "pubspec.yaml")) }
    UI.user_error!("cannot find the repo root (no pubspec.yaml above #{Dir.pwd})") unless root

    versionCode = bump_version_code

    sh("cd #{root} && flutter build appbundle " \
       "--build-name=1.0.#{versionCode} --build-number=#{versionCode} " \
       "--dart-define-from-file=assets/config.json")

    key = ENV["PLAY_JSON_KEY_PATH"]
    aab = "#{root}/build/app/outputs/bundle/release/app-release.aab"

    verify_signing(aab: aab)

    # charter.md Class B (fun-money loop): a PRODUCTION release never goes to 100%
    # in one step. PLAY_ROLLOUT is set by loop/release.sh; when it is unset the
    # arguments are omitted entirely and supply behaves exactly as it always did.
    #
    # Only the production track stages. Every testing track — internal, alpha and
    # beta — is Class A (charter, 2026-08-09): nobody on one is a customer, so a
    # staged rollout there only keeps some testers on the older build for longer.
    staged = (track == 'production' && !ENV["PLAY_ROLLOUT"].to_s.empty?) ?
      { rollout: ENV["PLAY_ROLLOUT"], release_status: "inProgress" } : {}

    upload_to_play_store(
      **{
        track: track,
        aab: aab,
      }.merge(key.to_s.empty? ? {} : { json_key: key }).merge(staged)
    )

    send_slack_notification(message: "New #{track} version 1.0.#{versionCode} (#{versionCode}) has been pushed to Google Play!")
  end
  
  desc "Deploy a new version to the Google Play production track"
  lane :prod do
    deploy(track: 'production')
  end
  
  desc "Deploy a new version to the internal test track of Google Play"
  lane :internal do
    deploy(track: 'internal')
  end

  desc "Deploy a new version to the alpha testing track of Google Play"
  lane :alpha do
    deploy(track: 'alpha')
  end

  desc "Deploy a new version to the beta testing track of Google Play"
  lane :beta do
    deploy(track: 'beta')
  end
  
  desc "Send a message to Slack"
  # Guarded, and that guard is the whole point. With no SLACK_WEBHOOK_URL the
  # slack action raises, so the lane exits non-zero AFTER upload_to_play_store has
  # already shipped. That happened on abis_recipes on 2026-07-30: the caller wrote
  # "nothing was uploaded" into the public log while real users took the build.
  lane :send_slack_notification do |options|
    url = ENV["SLACK_WEBHOOK_URL"]
    next UI.message("SLACK_WEBHOOK_URL unset - skipping notification") if url.to_s.empty?

    message = options[:message] || "A new update has been pushed!"
    # Every app posts to ONE shared webhook, so a message that does not name its
    # app cannot be read in that channel. The name is read from pubspec.yaml, so
    # an app scaffolded from this template labels itself with no rename step.
    # SLACK_APP_LABEL overrides it. (A lane body runs with cwd = fastlane/.)
    app_label = ENV["SLACK_APP_LABEL"].to_s.strip
    if app_label.empty?
      app_label = begin
        File.read("../../pubspec.yaml")[/^name:\s*(\S+)/, 1] || "unknown app"
      rescue StandardError
        "unknown app"
      end
    end
    message = "*#{app_label} (Android)* — #{message}"
    slack(
      message: message,
      success: true,
      slack_url: url
    )
  end
end
